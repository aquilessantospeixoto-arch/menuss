    TabBar         = Color3.fromRGB(18, 18, 28),
    TabButton      = Color3.fromRGB(30, 30, 45),
    TabActive      = Color3.fromRGB(80, 60, 180),
    Element        = Color3.fromRGB(30, 30, 45),
    ElementHover   = Color3.fromRGB(40, 40, 60),
    ElementStroke  = Color3.fromRGB(55, 55, 80),
    ToggleOff      = Color3.fromRGB(50, 50, 70),
