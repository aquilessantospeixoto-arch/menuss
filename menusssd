local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ══════════════════════════════════════
--  CONFIG
-- ══════════════════════════════════════
local FLING_FORCE     = 5e4
local COOLDOWN        = 1
local cooldowns: {[string]: number} = {}
local flingEnabled    = false

-- ══════════════════════════════════════
--  FLING CORE
-- ══════════════════════════════════════
local function flingCharacter(character: Model, origin: Vector3)
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid or humanoid.Health <= 0 then return end

    local player = Players:GetPlayerFromCharacter(character)
    if not player or player == LocalPlayer then return end

    local name = player.Name
    local now  = tick()
    if cooldowns[name] and now - cooldowns[name] < COOLDOWN then return end
    cooldowns[name] = now

    local dir = (rootPart.Position - origin)
    dir = (dir.Magnitude > 0 and dir.Unit or Vector3.new(0, 1, 0))
    local launchDir = (dir + Vector3.new(0, 0.6, 0)).Unit

    humanoid.PlatformStand = true
    rootPart.AssemblyLinearVelocity = launchDir * FLING_FORCE

    task.delay(0.5, function()
        if humanoid and humanoid.Parent then
            humanoid.PlatformStand = false
        end
    end)
end

local connections: {RBXScriptConnection} = {}

local function setupTouchDetection(character: Model)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            local conn = part.Touched:Connect(function(hit)
                if not flingEnabled then return end
                local hitChar = hit:FindFirstAncestorOfClass("Model")
                if not hitChar then return end
                local myRoot = character:FindFirstChild("HumanoidRootPart")
                flingCharacter(hitChar, myRoot and myRoot.Position or part.Position)
            end)
            table.insert(connections, conn)
        end
    end
end

local function clearConnections()
    for _, c in ipairs(connections) do c:Disconnect() end
    table.clear(connections)
end

local function onCharacterAdded(character: Model)
    clearConnections()
    character:WaitForChild("HumanoidRootPart")
    if flingEnabled then
        setupTouchDetection(character)
    end
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
if LocalPlayer.Character then
    onCharacterAdded(LocalPlayer.Character)
end

-- ══════════════════════════════════════
--  GUI
-- ══════════════════════════════════════
local screenGui = Instance.new("ScreenGui")
screenGui.Name        = "FlingTester"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent      = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size            = UDim2.new(0, 180, 0, 60)
frame.Position        = UDim2.new(0, 20, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
frame.BorderSizePixel = 0
frame.Active          = true
frame.Draggable       = true
frame.Parent          = screenGui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local label = Instance.new("TextLabel")
label.Size             = UDim2.new(1, 0, 0, 20)
label.Position         = UDim2.new(0, 0, 0, 4)
label.BackgroundTransparency = 1
label.Text             = "FLING ON TOUCH"
label.TextColor3       = Color3.fromRGB(200, 200, 200)
label.TextSize         = 11
label.Font             = Enum.Font.GothamBold
label.Parent           = frame

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size          = UDim2.new(0, 140, 0, 28)
toggleBtn.Position      = UDim2.new(0.5, -70, 0, 26)
toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleBtn.TextColor3    = Color3.fromRGB(255, 80, 80)
toggleBtn.Text          = "OFF"
toggleBtn.TextSize      = 13
toggleBtn.Font          = Enum.Font.GothamBold
toggleBtn.BorderSizePixel = 0
toggleBtn.Parent        = frame

Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 6)

toggleBtn.MouseButton1Click:Connect(function()
    flingEnabled = not flingEnabled

    if flingEnabled then
        toggleBtn.Text             = "ON"
        toggleBtn.TextColor3       = Color3.fromRGB(80, 255, 120)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 50, 25)
        if LocalPlayer.Character then
            setupTouchDetection(LocalPlayer.Character)
        end
    else
        toggleBtn.Text             = "OFF"
        toggleBtn.TextColor3       = Color3.fromRGB(255, 80, 80)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        clearConnections()
    end
end)
