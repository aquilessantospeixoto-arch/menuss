local function CreateToggle(parent, text, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 43)
    row.BackgroundColor3 = Theme.Panel
    row.BorderSizePixel = 0
    row.Parent = parent
    Corner(row, 8)
    Stroke(row, Theme.Stroke, 1)

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 1, -10)
    accent.Position = UDim2.fromOffset(0, 5)
    accent.BackgroundColor3 = Theme.Accent
    accent.BorderSizePixel = 0
    accent.Parent = row
    Corner(accent, 2)

    local label = Label(row, text, 12, Theme.Text)
    label.Position = UDim2.fromOffset(14, 0)
    label.Size = UDim2.new(1, -65, 1, 0)

    local button = Instance.new("TextButton")
    button.Text = ""
    button.AutoButtonColor = false
    button.Size = UDim2.fromOffset(42, 22)
    button.Position = UDim2.new(1, -53, 0.5, -11)
    button.BackgroundColor3 = Color3.fromRGB(57, 57, 82)
    button.BorderSizePixel = 0
    button.Parent = row
    Corner(button, 11)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14,14)
    knob.Position = UDim2.new(0, 4, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(245,245,250)
    knob.BorderSizePixel = 0
    knob.Parent = button
    Corner(knob, 99)

    local enabled = default == true

    local function setState(value)
        enabled = value
        local targetButton = enabled and Theme.Accent or Color3.fromRGB(57,57,82)
        local targetPos = enabled and UDim2.new(1,-18,0.5,-7) or UDim2.new(0,4,0.5,-7)

        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = targetButton
        }):Play()

        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = targetPos
        }):Play()

        if callback then
            callback(enabled)
        end
    end

    button.MouseButton1Click:Connect(function()
        setState(not enabled)
    end)

    setState(enabled)
    return row
end

local function CreateSlider(parent, text, min, max, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 62)
    row.BackgroundColor3 = Theme.Panel
    row.BorderSizePixel = 0
    row.Parent = parent
    Corner(row, 8)
    Stroke(row, Theme.Stroke, 1)

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0,3,1,-10)
    accent.Position = UDim2.fromOffset(0,5)
    accent.BackgroundColor3 = Theme.Accent
    accent.BorderSizePixel = 0
    accent.Parent = row
    Corner(accent,2)

    local title = Label(row, text, 12, Theme.Text)
    title.Position = UDim2.fromOffset(14, 5)
    title.Size = UDim2.new(1,-55,0,20)

    local valueLabel = Label(row, tostring(default), 11, Theme.Accent2)
    valueLabel.Position = UDim2.new(1,-42,0,5)
    valueLabel.Size = UDim2.fromOffset(32,20)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(14, 35)
    bar.Size = UDim2.new(1,-28,0,7)
    bar.BackgroundColor3 = Color3.fromRGB(42,42,62)
    bar.BorderSizePixel = 0
    bar.Parent = row
    Corner(bar, 99)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0,0,1,0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Corner(fill,99)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5,0.5)
    knob.Size = UDim2.fromOffset(17,17)
    knob.BackgroundColor3 = Color3.fromRGB(250,250,255)
    knob.BorderSizePixel = 0
    knob.Parent = bar
    Corner(knob,99)
    Stroke(knob, Theme.Accent, 1)

    local draggingSlider = false
    local value = default

    local function setValueFromX(x)
        local ratio = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = min + (max-min) * ratio

        if max-min <= 10 then
            value = math.floor(value * 10 + 0.5) / 10
        else
            value = math.floor(value + 0.5)
        end

        local pct = (value-min)/(max-min)
        fill.Size = UDim2.new(pct,0,1,0)
        knob.Position = UDim2.new(pct,0,0.5,0)
        valueLabel.Text = tostring(value)

        if callback then
            callback(value)
        end
    end

    local initialPct = math.clamp((default-min)/(max-min),0,1)
    fill.Size = UDim2.new(initialPct,0,1,0)
    knob.Position = UDim2.new(initialPct,0,0.5,0)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            setValueFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setValueFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    return row
end

local function CreateButton(parent, text, callback)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = false
    b.Text = text
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    b.TextColor3 = Theme.Text
    b.BackgroundColor3 = Theme.Panel
    b.BorderSizePixel = 0
    b.Size = UDim2.new(1,-4,0,43)
    b.Parent = parent
    Corner(b,8)
    Stroke(b,Theme.Stroke,1)

    b.MouseEnter:Connect(function()
        TweenService:Create(b,TweenInfo.new(0.12),{
            BackgroundColor3 = Theme.Panel2
        }):Play()
    end)

    b.MouseLeave:Connect(function()
        TweenService:Create(b,TweenInfo.new(0.12),{
            BackgroundColor3 = Theme.Panel
        }):Play()
    end)

    b.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)

    return b
end

