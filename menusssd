function uilibiri:createtab(nome)
    -- Tab button
    local btn = Instance.new("TextButton")
    btn.Name = "Tab_" .. nome
    btn.Parent = tabsinstance
    btn.BackgroundColor3 = THEME.TabButton
    btn.BorderSizePixel = 0
    btn.AutomaticSize = Enum.AutomaticSize.X
    btn.Size = UDim2.new(0, 0, 0, 24)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "  " .. nome .. "  "
    btn.TextColor3 = THEME.TextSecondary
    btn.TextSize = 12
    btn.AutoButtonColor = false
    corner(btn, 6)

    local activeIndicator = Instance.new("Frame")
    activeIndicator.Name = "Indicator"
    activeIndicator.Parent = btn
    activeIndicator.AnchorPoint = Vector2.new(0.5, 1)
    activeIndicator.BackgroundColor3 = THEME.Accent
    activeIndicator.BorderSizePixel = 0
    activeIndicator.Position = UDim2.new(0.5, 0, 1, 2)
    activeIndicator.Size = UDim2.new(0.6, 0, 0, 2)
    activeIndicator.Visible = false
    corner(activeIndicator, 2)

    -- Tab content frame
    local tab = Instance.new("Frame")
    tab.Name = nome
    tab.Parent = continstance
    tab.BackgroundTransparency = 1
    tab.BorderSizePixel = 0
    tab.Size = UDim2.new(1, 0, 0, 0)
    tab.AutomaticSize = Enum.AutomaticSize.Y
    tab.Visible = false

    local layout = Instance.new("UIListLayout")
    layout.Parent = tab
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)

    local pad = Instance.new("UIPadding")
    pad.Parent = tab
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)

    btn.MouseButton1Click:Connect(function()
        -- Deactivate all
        for _, t in pairs(tabsinstance:GetChildren()) do
            if t:IsA("TextButton") then
                tween(t, {BackgroundColor3 = THEME.TabButton, TextColor3 = THEME.TextSecondary})
                local ind = t:FindFirstChild("Indicator")
                if ind then ind.Visible = false end
            end
        end
        for _, c in pairs(continstance:GetChildren()) do
            if c:IsA("Frame") then c.Visible = false end
        end
        -- Activate this tab
        tween(btn, {BackgroundColor3 = THEME.TabActive, TextColor3 = THEME.TextPrimary})
        activeIndicator.Visible = true
        tab.Visible = true
    end)

    btn.MouseEnter:Connect(function()
        if btn.BackgroundColor3 ~= THEME.TabActive then
            tween(btn, {BackgroundColor3 = THEME.ElementHover})
        end
    end)
    btn.MouseLeave:Connect(function()
        if btn.BackgroundColor3 ~= THEME.TabActive then
            tween(btn, {BackgroundColor3 = THEME.TabButton})
        end
    end)
end

